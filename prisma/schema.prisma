generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataScope {
  SELF
  DEPT
  ALL
}

enum CatalogVersionStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum CaseStatus {
  DRAFT
  AWAITING_CUSTOMER
  CUSTOMER_EDITING
  PENDING_REVIEW
  NEEDS_SUPPLEMENT
  PENDING_REREVIEW
  FINALIZING
  PDF_FAILED
  COMPLETED
  CLOSED
}

enum ActorType {
  INTERNAL
  CUSTOMER
  SYSTEM
}

enum FilePurpose {
  MATERIAL
  HANDWRITTEN
  SEAL_ORIGINAL
  SEAL_PROCESSED
  PRESIGN_PDF
  FINAL_PDF
}

enum SignatureMode {
  HANDWRITTEN
  STAMP_UPLOAD
}

enum EvidenceMode {
  ORDINARY
  TRUSTED_TIMESTAMP
  CA_CERTIFICATE
  E_CONTRACT_PROVIDER
}

enum ReviewDecision {
  APPROVE
  REJECT
}

enum PdfTaskStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum FinalizationDeliveryStatus {
  NOT_READY
  PENDING
  DELIVERED
  FAILED
}

enum QuotationSource {
  MANUAL
  URL
  LOCAL_STORAGE
  UPSTREAM_SYSTEM
}

model CachedBackendUser {
  tokenDigest    String   @id @map("token_digest")
  userId         String   @map("user_id")
  name           String?
  departmentId   String?  @map("department_id")
  departmentName String?  @map("department_name")
  roles          Json
  expiresAt      DateTime @db.Timestamptz(6) @map("expires_at")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@index([expiresAt])
  @@map("CachedBackendUser")
}

model UpstreamDepartment {
  id        String   @id
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("UpstreamDepartment")
}

model UpstreamUser {
  id             String   @id
  name           String
  departmentId   String?  @map("department_id")
  departmentName String?  @map("department_name")
  roles          Json
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("UpstreamUser")
}

model RoleMapping {
  roleKey      String    @id @map("role_key")
  capabilities Json
  dataScope    DataScope @map("data_scope")
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")

  @@map("RoleMapping")
}

model Requirement {
  id        String               @id @default(cuid())
  key       String               @unique
  name      String
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  versions  RequirementVersion[]

  @@map("Requirement")
}

model RequirementVersion {
  id            String               @id @default(cuid())
  requirementId String               @map("requirement_id")
  version       Int
  status        CatalogVersionStatus @default(DRAFT)
  definition    Json
  createdBy     String               @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at")
  publishedAt   DateTime?            @map("published_at")
  disabledAt    DateTime?            @map("disabled_at")
  requirement   Requirement          @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  templateLinks TemplateVersionRequirement[]
  snapshots     CaseSnapshotRequirement[]
  files         FileRecord[]
  reviews       RequirementReview[]
  reviewHistory ReviewHistory[]

  @@unique([requirementId, version])
  @@index([status])
  @@map("RequirementVersion")
}

model Template {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  versions    TemplateVersion[]

  @@map("Template")
}

model TemplateVersion {
  id            String               @id @default(cuid())
  templateId    String               @map("template_id")
  version       Int
  status        CatalogVersionStatus @default(DRAFT)
  ast           Json
  signatureMode SignatureMode        @map("signature_mode")
  createdBy     String               @map("created_by")
  createdAt     DateTime             @default(now()) @map("created_at")
  publishedAt   DateTime?            @map("published_at")
  disabledAt    DateTime?            @map("disabled_at")
  template      Template             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  requirements  TemplateVersionRequirement[]
  cases         BusinessCase[]
  snapshots     CaseSnapshot[]
  pdfTasks      PdfTask[]

  @@unique([templateId, version])
  @@index([status])
  @@map("TemplateVersion")
}

model TemplateVersionRequirement {
  templateVersionId    String             @map("template_version_id")
  requirementVersionId String             @map("requirement_version_id")
  position             Int
  templateVersion      TemplateVersion    @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  requirementVersion   RequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)

  @@id([templateVersionId, requirementVersionId])
  @@unique([templateVersionId, position])
  @@map("TemplateVersionRequirement")
}

model BusinessCase {
  id                String          @id @default(cuid())
  caseNumber        String          @unique @map("case_number")
  customerName      String          @map("customer_name")
  contactName       String          @map("contact_name")
  factoryDepartment String          @map("factory_department")
  status            CaseStatus      @default(DRAFT)
  templateVersionId String          @map("template_version_id")
  ownerUserId       String          @map("owner_user_id")
  reviewerUserId    String?         @map("reviewer_user_id")
  departmentId      String          @map("department_id")
  createdBy         String          @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  closedAt          DateTime?       @map("closed_at")
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  snapshots         CaseSnapshot[]
  statusHistory     CaseStatusHistory[]
  publicLinks       PublicCaseLink[]
  drafts            CaseDraft[]
  answers           AnswerHistory[]
  files             FileRecord[]
  fileVersions      FileVersion[]
  signings          SigningRecord[]
  reviews           RequirementReview[]
  reviewHistory     ReviewHistory[]
  pdfTasks          PdfTask[]

  @@index([status, departmentId])
  @@index([ownerUserId])
  @@index([reviewerUserId])
  @@map("BusinessCase")
}

model CaseSnapshot {
  id                String          @id @default(cuid())
  caseId            String          @map("case_id")
  version           Int
  templateVersionId String          @map("template_version_id")
  customerName      String          @map("customer_name")
  contactName       String          @map("contact_name")
  factoryDepartment String          @map("factory_department")
  materials         Json
  quotationSource       QuotationSource @map("quotation_source")
  quotationSourceSystem String?         @map("quotation_source_system")
  quotationReference    String?         @map("quotation_reference")
  quotationSnapshot     Json            @map("quotation_snapshot")
  createdBy         String          @map("created_by")
  createdAt         DateTime        @default(now()) @map("created_at")
  frozenAt         DateTime?       @map("frozen_at")
  businessCase      BusinessCase    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  requirements      CaseSnapshotRequirement[]
  pdfTasks          PdfTask[]       @relation("PdfTaskSnapshot")

  @@unique([caseId, version])
  @@map("CaseSnapshot")
}

model CaseSnapshotRequirement {
  caseSnapshotId       String             @map("case_snapshot_id")
  requirementVersionId String             @map("requirement_version_id")
  position             Int
  caseSnapshot         CaseSnapshot       @relation(fields: [caseSnapshotId], references: [id], onDelete: Restrict)
  requirementVersion   RequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)

  @@id([caseSnapshotId, requirementVersionId])
  @@unique([caseSnapshotId, position])
  @@map("CaseSnapshotRequirement")
}

model CaseStatusHistory {
  id          String     @id @default(cuid())
  caseId      String     @map("case_id")
  fromStatus  CaseStatus? @map("from_status")
  toStatus    CaseStatus @map("to_status")
  actorUserId String     @map("actor_user_id")
  reason      String?
  createdAt   DateTime   @default(now()) @map("created_at")
  businessCase BusinessCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("CaseStatusHistory")
}

model PublicCaseLink {
  id          String    @id @default(cuid())
  caseId      String    @map("case_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  disabledAt  DateTime? @map("disabled_at")
  consumedAt  DateTime? @map("consumed_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  businessCase BusinessCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@map("PublicCaseLink")
}

model CaseDraft {
  id          String    @id @default(cuid())
  caseId      String    @map("case_id")
  version     Int
  baseVersion Int       @map("base_version")
  content     Json
  actorType   ActorType @map("actor_type")
  createdAt   DateTime  @default(now()) @map("created_at")
  businessCase BusinessCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@unique([caseId, version])
  @@map("CaseDraft")
}

model AnswerHistory {
  id           String    @id @default(cuid())
  caseId       String    @map("case_id")
  draftVersion Int       @map("draft_version")
  answers      Json
  actorType    ActorType @map("actor_type")
  createdAt    DateTime  @default(now()) @map("created_at")
  businessCase BusinessCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, draftVersion])
  @@map("AnswerHistory")
}

model FileRecord {
  id                   String             @id @default(cuid())
  caseId               String             @map("case_id")
  requirementVersionId String?            @map("requirement_version_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  removedAt            DateTime?          @map("removed_at")
  removedBy            String?            @map("removed_by")
  removeReason         String?            @map("remove_reason")
  businessCase         BusinessCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  requirementVersion   RequirementVersion? @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)
  versions             FileVersion[]

  @@unique([id, caseId])
  @@index([caseId, requirementVersionId, removedAt])
  @@map("FileRecord")
}

model FileVersion {
  id           String    @id @default(cuid())
  fileId       String    @map("file_id")
  caseId       String    @map("case_id")
  version      Int
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  sha256       String
  storageKey   String    @unique @map("storage_key")
  actorType    ActorType @map("actor_type")
  purpose      FilePurpose @default(MATERIAL)
  draftVersion Int?       @map("draft_version")
  contentDigest String?    @map("content_digest")
  originalFileVersionId String? @map("original_file_version_id")
  cacheActive Boolean @default(true) @map("cache_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  file         FileRecord @relation(fields: [fileId, caseId], references: [id, caseId], onDelete: Restrict)
  businessCase BusinessCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  signingResources SigningRecord[] @relation("SigningResource")
  preSignPdfs      SigningRecord[] @relation("PreSignPdf")
  pdfOutputs       PdfTask[]
  originalFileVersion FileVersion? @relation("FileVersionDerivation", fields: [originalFileVersionId], references: [id], onDelete: Restrict)
  derivedFileVersions FileVersion[] @relation("FileVersionDerivation")

  @@unique([fileId, version])
  @@unique([id, caseId])
  @@index([caseId])
  @@index([caseId, purpose, draftVersion, contentDigest])
  @@index([originalFileVersionId])
  @@map("FileVersion")
}

model SigningRecord {
  id                      String        @id @default(cuid())
  caseId                  String        @map("case_id")
  version                 Int
  draftVersion            Int           @map("draft_version")
  contentDigest           String        @map("content_digest")
  signer                  String        @default("PARTY_A")
  mode                    SignatureMode
  evidenceMode            EvidenceMode  @default(ORDINARY) @map("evidence_mode")
  evidenceProvider        String?       @map("evidence_provider")
  evidenceExternalId      String?       @map("evidence_external_id")
  evidencePayload         Json?         @map("evidence_payload")
  resourceFileVersionId   String        @map("resource_file_version_id")
  payload                 Json
  preSignPdfFileVersionId String        @map("pre_sign_pdf_file_version_id")
  preSignPdfSha256        String        @map("pre_sign_pdf_sha256")
  clientIp                String        @map("client_ip")
  userAgent               String        @map("user_agent")
  signedAt                DateTime      @default(now()) @map("signed_at")
  valid                   Boolean       @default(true)
  invalidatedAt           DateTime?     @map("invalidated_at")
  invalidationReason      String?       @map("invalidation_reason")
  businessCase            BusinessCase  @relation(fields: [caseId], references: [id], onDelete: Restrict)
  resourceFileVersion     FileVersion   @relation("SigningResource", fields: [resourceFileVersionId, caseId], references: [id, caseId], onDelete: Restrict)
  preSignPdfFileVersion   FileVersion   @relation("PreSignPdf", fields: [preSignPdfFileVersionId, caseId], references: [id, caseId], onDelete: Restrict)
  pdfTasks                PdfTask[]     @relation("PdfTaskSigning")

  @@unique([caseId, version])
  @@index([caseId, draftVersion, contentDigest])
  @@map("SigningRecord")
}

model RequirementReview {
  id                   String             @id @default(cuid())
  caseId               String             @map("case_id")
  requirementVersionId String             @map("requirement_version_id")
  decision             ReviewDecision
  reason               String?
  reviewerUserId       String             @map("reviewer_user_id")
  version              Int
  updatedAt            DateTime           @updatedAt @map("updated_at")
  businessCase         BusinessCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  requirementVersion   RequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)

  @@unique([caseId, requirementVersionId])
  @@map("RequirementReview")
}

model ReviewHistory {
  id                   String         @id @default(cuid())
  caseId               String         @map("case_id")
  requirementVersionId String         @map("requirement_version_id")
  version              Int
  decision             ReviewDecision
  reason               String?
  reviewerUserId       String         @map("reviewer_user_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  businessCase         BusinessCase   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  requirementVersion   RequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)

  @@unique([caseId, requirementVersionId, version])
  @@map("ReviewHistory")
}

model AuditEvent {
  id          String    @id @default(cuid())
  actorUserId String?   @map("actor_user_id")
  actorType   ActorType @default(INTERNAL) @map("actor_type")
  action      String
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  detail      Json
  source      String?
  requestId   String?   @map("request_id")
  beforeState Json?     @map("before_state")
  afterState  Json?     @map("after_state")
  note        String?
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId, createdAt])
  @@map("AuditEvent")
}

model SystemSetting {
  key           String   @id
  value         String
  masked        Boolean  @default(false)
  encryptionVersion Int? @map("encryption_version")
  encryptionIv      String? @map("encryption_iv")
  encryptionTag     String? @map("encryption_tag")
  updatedBy     String   @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("SystemSetting")
}

model PdfTask {
  id                  String        @id @default(cuid())
  caseId              String        @map("case_id")
  templateVersionId   String        @map("template_version_id")
  dataSnapshotVersion Int           @map("data_snapshot_version")
  signatureVersion    Int           @map("signature_version")
  idempotencyKey      String        @unique @map("idempotency_key")
  status              PdfTaskStatus @default(QUEUED)
  attempts            Int           @default(0)
  maxAttempts         Int           @default(3) @map("max_attempts")
  outputFileVersionId String?       @map("output_file_version_id")
  outputSha256        String?       @map("output_sha256")
  failureCode         String?       @map("failure_code")
  failureMessage      String?       @map("failure_message")
  startedAt           DateTime?     @map("started_at")
  leaseToken          String?       @map("lease_token")
  claimGeneration     Int           @default(0) @map("claim_generation")
  queueGeneration     Int           @default(0) @map("queue_generation")
  deliveryGeneration  Int           @default(0) @map("delivery_generation")
  pendingStorageKey   String?       @map("pending_storage_key")
  pendingSha256       String?       @map("pending_sha256")
  pendingSizeBytes    Int?          @map("pending_size_bytes")
  finishedAt          DateTime?     @map("finished_at")
  finalizationStatus  FinalizationDeliveryStatus @default(NOT_READY) @map("finalization_status")
  finalizationAttempts Int          @default(0) @map("finalization_attempts")
  finalizationFailure String?       @map("finalization_failure")
  finalizationFailedAt DateTime?    @map("finalization_failed_at")
  finalizedAt         DateTime?     @map("finalized_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  businessCase        BusinessCase  @relation(fields: [caseId], references: [id], onDelete: Restrict)
  templateVersion     TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  outputFileVersion   FileVersion?  @relation(fields: [outputFileVersionId, caseId], references: [id, caseId], onDelete: Restrict)
  dataSnapshot        CaseSnapshot  @relation("PdfTaskSnapshot", fields: [caseId, dataSnapshotVersion], references: [caseId, version], onDelete: Restrict)
  signing             SigningRecord @relation("PdfTaskSigning", fields: [caseId, signatureVersion], references: [caseId, version], onDelete: Restrict)
  queueOutbox          PdfQueueOutbox[]

  @@index([status, createdAt])
  @@index([status, startedAt])
  @@map("PdfTask")
}

model PdfQueueOutbox {
  id          String   @id @default(cuid())
  taskId      String   @map("task_id")
  queueName   String   @map("queue_name")
  generation  Int
  payload     Json
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")
  bossJobId   String?  @map("boss_job_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  task        PdfTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, queueName, generation])
  @@index([publishedAt, createdAt])
  @@map("PdfQueueOutbox")
}
