DATABASE_URL=postgresql://user:password@localhost:5432/authorization
# 32 random bytes encoded as base64; generate a unique production value and never commit it.
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Legacy in-memory demo endpoints are disabled by default. Production APIs use database repositories.
USE_IN_MEMORY_STORE=false
CORS_ALLOWED_ORIGINS=https://authorization.example.com
AUTH_GET_INFO_URL=https://auth.example.test/getInfo
AUTH_TOKEN_HEADER=Authorization
AUTH_TIMEOUT_MS=3000
AUTH_CACHE_TTL_SECONDS=60
STORAGE_ROOT=./data/private-files
H5_PUBLIC_BASE=https://h5.example.test
LINK_DEADLINE_POLICY=CASE_DEADLINE
LOG_LEVEL=info
# 私有文件存储（后续 NAS 可通过 STORAGE_MODE 新后端接入）
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=./data/private-files
# NAS v1 通过操作系统挂载后仍使用 local 驱动；将此值指向挂载目录（Windows 可为 UNC/盘符）。
STORAGE_NAS_MOUNT_ROOT=
STORAGE_NAS_HEALTHCHECK_FILE=.authorization-storage-ready
# Chromium/Chrome executable; PDF generation fails closed when this is missing.
CHROMIUM_EXECUTABLE_PATH=
API_PORT=3000
API_PUBLIC_URL=https://authorization.example.com/api
ADMIN_PUBLIC_URL=https://authorization.example.com/admin
TLS_CERTIFICATE_PATH=C:\authorization\tls\fullchain.pem
TLS_CERTIFICATE_KEY_PATH=C:\authorization\tls\private.key
PUBLIC_LINK_DEFAULT_TTL_HOURS=168
MAX_UPLOAD_BYTES=20971520
WORKER_HEARTBEAT_FILE=./data/worker-heartbeat.json
CHROMIUM_EXPECTED_MAJOR=
CHROMIUM_ALLOW_NO_SANDBOX=false
# API consumes finalization events when enabled. Worker uses DATABASE_URL for the same pg-boss schema.
PG_BOSS_ENABLED=true
# Chromium/Chrome 可执行文件绝对路径；缺失时 PDF 服务会安全失败
CHROMIUM_EXECUTABLE_PATH=
